# ==============================================================================
# VoiceShield AI — Environment Configuration Template
# Copy this file to .env and fill in your actual keys.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Python Environment Path (virtualenv recommended)
PYTHON_PATH=.venv/bin/python

# Google Gemini API (Used for conversational assistant & detection explanations)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Specialist Acoustic Deepfake Detection (Optional)
# If provided, Reality Defender API is used as the Tier 1 specialist detector.
# If omitted or invalid, AASIST local specialist model is used.
REALITY_DEFENDER_API_KEY=your_reality_defender_api_key_here

# Speech Recognition & Offline Behavior
# WHISPER_MODEL_ID: HuggingFace model repository ID for local speech-to-text (defaults to openai/whisper-small)
# NOTE: This loads locally via HuggingFace transformers, NOT the paid OpenAI API.
WHISPER_MODEL_ID=openai/whisper-small
# Set HF_OFFLINE=1 to prevent HuggingFace Hub network calls and use local cache
HF_OFFLINE=1

# AssemblyAI (Optional alternative speech recognition)
ASSEMBLYAI_API_KEY=

# Audio Preprocessing Limits
MAX_AUDIO_DURATION_SEC=30
MIN_AUDIO_DURATION_SEC=0.5
TARGET_SAMPLE_RATE=16000
